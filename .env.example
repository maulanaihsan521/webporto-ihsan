# ==============================================================
# Portfolio Maulana Ihsan Rohim — Environment Variables
# Salin file ini menjadi .env lalu isi nilai asli.
#    cp .env.example .env
# JANGAN pernah commit file .env ke repository!
# ==============================================================

# --- Database (Supabase Postgres) ---
# Transaction pooler (port 6543) — dipakai runtime aplikasi (serverless-friendly)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler (port 5432) — untuk migrasi Prisma
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Auth ---
# Secret untuk signing JWT session admin (generate: openssl rand -hex 32)
JWT_SECRET="ganti-dengan-string-acak-64-karakter"

# --- Site ---
NEXT_PUBLIC_SITE_URL="https://portofoliomaulanaihsan.my.id"

# --- Supabase Storage (upload media) ---
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxxxxxxxxxxxxxxx"
SUPABASE_STORAGE_BUCKET="media"
